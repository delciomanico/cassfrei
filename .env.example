# Ligação ao Dynamix-CMS (variáveis do Vite — lidas em build-time).
# Todas opcionais: sem elas usa-se o defeito indicado.
VITE_DYNAMIX_API_URL=https://dynamix.cassfrei.com/api/v1
VITE_DYNAMIX_PROJECT=cassfrei
# Pôr "true" para ignorar o CMS e mostrar só o conteúdo estático de src/data/
VITE_DYNAMIX_DISABLED=false
